# Ray runtime_env packaging ignore file.
#
# Keep package source, pyproject files, lock files, and root scripts available
# to workers. Ignore docs, tests, local outputs, build products, and heavyweight
# development assets that should not be uploaded with every Ray job.

# VCS and local agent/editor state
.git/
.github/
.gitattributes
.gitignore
.dockerignore
.rayignore
.agents/
.claude/
.codex/
.cursor/
.cursor-server/
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Python caches, build outputs, and virtualenvs
__pycache__/
*.py[cod]
*$py.class
.ruff_cache/
.pytest_cache/
.mypy_cache/
.pyre/
.hypothesis/
.cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
.Python
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
__pypackages__/

# Documentation sites and rendered docs
docs/
**/docs/
site/
**/site/
*_build/
**/_build/

# Tests, examples, notebooks, and local dev scripts inside packages
tests/
test/
**/tests/
**/test/
examples/
**/examples/
benchmarks/
**/benchmarks/
notebooks/
**/notebooks/
*.ipynb
.ipynb_checkpoints/
libs/ejkernel/scripts/
libs/spectrax/scripts/

# Native/kernel development trees and compiled artifacts.
# Keep this out of Ray uploads unless workers are intentionally compiling
# native ejkernel/CUTLASS/CUDA artifacts from source.
libs/ejkernel/csrc/
*.so
*.o
*.a
*.dll
*.dylib
*.exe

# Logs, profiler dumps, local debugging, and experiment outputs
*.log
nohup.out
logs/
debug/
profiling/
xprof/
xprof-*/
*.prof
*.pstats
memory.prof
memory.prof.*
memory_log_dir/
wandb/
runs/
outputs/
results/
tmp/
temp/
tmp-files/
*.tmp
*.bak
*.backup
*.old
~*

# Model/checkpoint/data artifacts that should live in object storage or mounts
EasyDeL-Checkpoints/
easydel-Checkpoints/
checkpoint*/
checkpoints/
models/
model-files/
/data/
/datasets/
*.ckpt
*.safetensors
*.pt
*.pth
*.h5
*.hdf5
*.pkl
*.pickle
*.bin
*.easy

# Archives and compressed artifacts
*.tar
*.tar.gz
*.tgz
*.zip
*.rar
*.7z
*.gz

# Repo-local scratch files from previous experiments
execute_command.sh
env.ipynb
env.py
exp.py
vxp.py
launch_test.py
sharding_test.py
exprimental.py
generated-readmes/
cluster.yaml
autoscale/cluster.yaml
autoscale/easydel-*.yaml
!autoscale/easydel-cluster-template.yaml
.gradio/
mojo_module/
test.mojo
run.mojo
cuda_stuff/
aten_lib/
.serena/
